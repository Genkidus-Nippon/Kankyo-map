function withAllExtra(ind){
  const data = { ...ind.data };
  for (const src of [EXTRA, EXTRA2]){
    for (const [c, obj] of Object.entries(src)){
      const v = obj[ind.key];
      if (v != null) data[c] = v;
    }
  }
  return data;
}

// SDGsの定量目標（各指標に対応）
const TARGETS = {
  poverty:"2030年までに極度の貧困を撲滅（1日2.15ドル未満を実質ゼロに）",
  undernourish:"2030年までに飢餓をゼロに", life:"健康な生活の確保（平均寿命の延伸）",
