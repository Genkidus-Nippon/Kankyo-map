const SOURCE = "代表値モデル（UN SDG指標・世界銀行等の傾向に基づく概算）";

// SDGsの定量目標（各指標に対応）
const TARGETS = {
  poverty:"2030年までに極度の貧困を撲滅（1日2.15ドル未満を実質ゼロに）",
  undernourish:"2030年までに飢餓をゼロに", life:"健康な生活の確保（平均寿命の延伸）",
  infant:"新生児・5歳未満児の予防可能な死亡をなくす", literacy:"2030年までにすべての若者が読み書き可能に（100%）",
  gender:"ジェンダー完全平等（指数1.0）", women_parl:"意思決定への女性の完全な参画",
  water:"2030年までに安全な水を全員に（100%）", electricity:"2030年までに電力を全員に（100%）",
  renew:"再生可能エネルギー比率の大幅な拡大", unemp:"完全かつ生産的な雇用の達成",
  gni:"持続的な経済成長", rnd:"研究開発への投資拡大", gini:"下位40%の所得成長を促進し格差を縮小",
  pm25:"WHO大気質指針 年平均5µg/m³以下", co2pc:"一人当たり排出量の削減",
  co2total:"温室効果ガス排出の実質ゼロ（2050年）", marine:"沿岸・海域の10%以上を保全",
  forest:"森林の持続可能な管理と回復", homicide:"あらゆる形態の暴力を大幅に減少",
  cpi:"汚職・贈収賄を大幅に削減", internet:"普遍的で安価なインターネットアクセス（100%）",
  mobile:"情報通信技術へのアクセス拡大",
};

function goalById(id){ return GOALS.find(g => g.id === Number(id)); }
function indicator(goalId, key){
  const g = goalById(goalId); if (!g) return null;
  return g.indicators.find(i => i.key === key) || g.indicators[0];
}
function buildScore(ind){
  const vals = Object.values(ind.data);
  const min = Math.min(...vals), max = Math.max(...vals), span = (max - min) || 1;
  const score = {};
  for (const [c, v] of Object.entries(ind.data)){
    const t = (v - min) / span;
    score[c] = ind.higherIsBetter ? (1 - t) : t;
  }
  return { score, min, max };
}
function getSdg(goalId, key){
  const g = goalById(goalId); if (!g) return null;
  const ind = indicator(goalId, key); if (!ind) return null;
  const { score, min, max } = buildScore(ind);
  return {
    ok:true, goalId:g.id, goalTitle:g.title, color:g.color,
    key:ind.key, label:ind.label, unit:ind.unit, higherIsBetter:ind.higherIsBetter,
    data:ind.data, scoreData:score, min, max, source:SOURCE, target:TARGETS[ind.key]||"",
    lowLabel:"良好", highLabel:"課題大", count:Object.keys(ind.data).length,
  };
}
function goalsMeta(){
  return GOALS.map(g => ({ id:g.id, title:g.title, color:g.color,
    indicators:g.indicators.map(i => ({ key:i.key, label:i.label })) }));
}

